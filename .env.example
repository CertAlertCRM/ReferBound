# ── Supabase (Project Settings → API) ────────────────────────────────────────
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Agent access ─────────────────────────────────────────────────────────────
# The passcode you type on /login. Pick something long-ish.
AGENT_PASSCODE=change-me
# Where "new referral from partner" alerts are sent
AGENT_EMAIL=faldendj12@gmail.com

# ── App URL (used in email links) ────────────────────────────────────────────
APP_URL=https://your-app.vercel.app

# ── Email via Resend (optional — app works without it; emails are logged) ────
# Create an API key at resend.com. EMAIL_FROM must be on a domain you verified
# in Resend, e.g. "David Falden <updates@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=

# ── Cron protection (any random string; Vercel Cron sends it automatically
#    if you set CRON_SECRET in Vercel env vars) ──────────────────────────────
CRON_SECRET=

# ── Branding (safe to expose; shown in the UI) ───────────────────────────────
NEXT_PUBLIC_AGENCY_NAME="Your Agency Name"
NEXT_PUBLIC_AGENT_NAME="David Falden"
NEXT_PUBLIC_PRODUCT_NAME="ReferLive"
