# ── Supabase (Project Settings → API) ────────────────────────────────────────
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Sessions & accounts ──────────────────────────────────────────────────────
# Signs account session cookies. Any long random string. Changing it signs
# everyone out.
SESSION_SECRET=change-me-long-random
# Founding-agent email: the FIRST signup with this email adopts all pilot data
# created before accounts existed. Also the fallback notification address.
AGENT_EMAIL=faldendj12@gmail.com

# ── Stripe (Payment Links flow) ──────────────────────────────────────────────
# Create Payment Links in the Stripe dashboard (Pro $20/mo, Agency $99/mo,
# Founder Annual $199/yr) and a no-code Customer Portal link
# (Settings → Billing → Customer portal).
NEXT_PUBLIC_STRIPE_LINK_PRO=
NEXT_PUBLIC_STRIPE_LINK_AGENCY=
NEXT_PUBLIC_STRIPE_LINK_FOUNDER=
NEXT_PUBLIC_STRIPE_PORTAL_LINK=
# Custom/discounted links are NOT env vars — create the Payment Link in Stripe
# and hand it out with ?client_reference_id=<accountId>_agency appended (the
# suffix is what tells the webhook which plan to grant, regardless of price).
# Webhook endpoint https://referbound.com/api/stripe/webhook with events:
# checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# ── App URL (used in email links) ────────────────────────────────────────────
APP_URL=https://your-app.vercel.app

# ── Email via Resend (optional — app works without it; emails are logged) ────
# Create an API key at resend.com. EMAIL_FROM must be on a domain you verified
# in Resend, e.g. "David Falden <updates@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=

# ── Product feedback inbox (the founder's email; falls back to AGENT_EMAIL) ──
FEEDBACK_EMAIL=

# ── SMS via Twilio (optional — texts silently skip if unset) ─────────────────
# Console → Account SID + Auth Token; TWILIO_FROM is your Twilio phone number
# in E.164 format, e.g. +18045551234
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Cron protection (any random string; Vercel Cron sends it automatically
#    if you set CRON_SECRET in Vercel env vars) ──────────────────────────────
CRON_SECRET=

# ── Branding (safe to expose; shown in the UI) ───────────────────────────────
NEXT_PUBLIC_AGENCY_NAME="Your Agency Name"
NEXT_PUBLIC_AGENT_NAME="David Falden"
NEXT_PUBLIC_PRODUCT_NAME="ReferBound"
